# Node Observer (observer), generated by the RSOS planner from an intake (spec/NODES.md).
PROTOCOL node_observer "Node: Observer"
VERSION 1.0
SAFETY max_per_hour=6 max_per_day=20 refractory=90s haptic_max=0.4
BREATH inhale=4s exhale=6s

TIER 1 OBSERVER {
  V "A clear, empty space around you"
  A "Nothing binds. Nothing holds. Only observed"
  K "The body still, nothing held"
  GLYPH "∅"
  WORD "No ego: nothing binds, only observed"
  FRAME "Nothing binds. Nothing holds. Only observed"
  MODE "observer"
  TACTON "-"
}

PHASE stillness dur=3s {
  FEEL "Stillness. The body stays still"
}
PHASE inhale breath=inhale {
  ACTIVATE OBSERVER
  SEE "A clear, empty space around you"
}
PHASE frame1 breath=exhale {
  SAY "Nothing binds. Nothing holds. Only observed"
}
PHASE position dur=4s {
  SEE "See it from another position: nothing binds, only observed"
}
PHASE seal breath=exhale {
  FEEL "Let it settle"
  MARK "installed"
}
