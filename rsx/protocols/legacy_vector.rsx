# The canonical 17-vector command from the RSX v1 specification (archive), run by the v2 runtime.
# Operators with a defined runtime effect are executed; the rest are recorded with a warning.
PROTOCOL legacy_tier8 "Legacy RSX v1 command (tier 8)"
VERSION 1.0
TIER 1 LION {
  V "Golden lion light"
  A "Courage"
  K "Warmth in the belly"
}
TIER 8 :: {DRAGON} :: (OVERRIDE) :: @Vector1:IdentityRebuild :: @Vector2:SymbolicEcho :: @Vector3:BreathOverride :: @Vector4:PostureShift :: @Vector5:MemoryRecall(Archetype=LION) :: @Vector6:EmotionalLock(Calm) :: @Vector7:EthicsContain(CONTAIN) :: @Vector8:CompressionRun(CM1) :: @Vector9:FutureProjection(3Years) :: @Vector10:ArchetypeMerge(LION+DRAGON) :: @Vector11:DeviceOutput(AR) :: @Vector12:DeviceOutput(EEG) :: @Vector13:SymbolicDriftCheck :: @Vector14:RecursiveLawApply :: @Vector15:MemoryUpdate(MEMSTACK) :: @Vector16:SymbolicCommandExport(RSX) :: @Vector17:EchoPropagationStop
