# Node Lion (associated), generated by the RSOS planner from an intake (spec/NODES.md).
PROTOCOL node_lion "Node: Lion"
VERSION 1.0
SAFETY max_per_hour=6 max_per_day=20 refractory=90s haptic_max=0.4
BREATH inhale=4s exhale=6s

TIER 1 LION {
  V "A sphere of golden light"
  A "I breathe fully and completely, and I hold my ground"
  K "Spine straight, saying no with calm confidence"
  O "Cedar"
  GLYPH "🦁"
  WORD "Courage and boundaries"
  FRAME "I breathe fully and completely, and I hold my ground"
  MODE "associated"
  TACTON "..-"
}

FUTURES "Saying no to scrolling and moving to the task" | "At work"

PHASE interrupt {
  SAY "I move, I act"
  GESTURE "Spine straight, head up, clench your fist"
}
PHASE inhale breath=inhale {
  ACTIVATE LION
  SEE "A sphere of golden light"
}
PHASE frame1 breath=exhale {
  SAY "I breathe fully and completely, and I hold my ground"
}
PHASE breathe1 breath=inhale {
  FEEL "Breathe in"
}
PHASE futures breath=exhale {
  FEEL "Hold the lion in you as you enter"
  FOR FUTURE {
    SEE "$future"
    WAIT 1s
  }
}
PHASE breathe2 breath=inhale {
  FEEL "Breathe in"
}
PHASE seal breath=exhale {
  SAY "I own"
  MARK "installed"
}
